# Kopie als .env.local (lokal) oder als echte Umgebungsvariablen (Server) anlegen.
# Diese Datei enthält nur Platzhalter und darf ins Repo.

# Hauptschlüssel für Verschlüsselung und E-Mail-Hash. Erzeugen mit: npm run keygen
# Mehrere Schlüssel durch Komma trennen, der erste ist der aktuelle (Rotation).
# Diesen Schlüssel getrennt von Datenbank und Backups aufbewahren.
APP_ENCRYPTION_KEYS=1:HIER_SCHLUESSEL_EINTRAGEN

# Ordner für Datenbank und hochgeladene Dateien. Muss außerhalb des Web-Roots liegen.
DATA_DIR=./data

# Aufbewahrung nach dem Veranstaltungsdatum in Monaten (Vorschlag, mit der Schule abstimmen).
RETENTION_MONTHS=6

# Aufbewahrung des Protokolls in Tagen (Vorschlag, mit dem Datenschutzbeauftragten abstimmen).
PROTOKOLL_AUFBEWAHRUNG_TAGE=180

# Nur auf 1 setzen, wenn die App hinter einem eigenen Reverse Proxy läuft, der X-Forwarded-For setzt.
# Ohne diese Einstellung gibt es keine IP-Adressen im Protokoll und keine IP-Drosselung.
TRUST_PROXY=0

# Aktive Anmeldemethoden, durch Komma getrennt. Weitere Anbieter siehe lib/server/auth/anbieter.ts.
AUTH_ANBIETER=passwort

# E-Mail ---------------------------------------------------------------------
# Öffentliche Adresse der Seite, ohne Schrägstrich am Ende. Links in E-Mails beginnen damit.
# Im Betrieb Pflicht: Ohne sie werden keine Mails verschickt.
APP_URL=https://technik.beispiel-schule.de

# SMTP-Server der Schule. Ohne SMTP_HOST erscheinen Mails in der Entwicklung im Terminal
# und werden im Betrieb nicht verschickt (die Anmeldung bleibt trotzdem gespeichert).
SMTP_HOST=
SMTP_PORT=587
# Nur setzen, wenn der Port nicht 465 ist und trotzdem von Anfang an verschlüsselt wird (1) oder 465 nicht verschlüsselt ist (0).
# SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Absender, zum Beispiel: Technikteam <technik@beispiel-schule.de>
# Lehrkräfte antworten auf diese Adresse. Sie sollte ein Postfach sein, das jemand liest.
MAIL_FROM=

# Nur zum Ausprobieren eines Produktions-Builds ohne SMTP: 1 gibt Mails samt Links im Terminal aus.
# Nie auf dem echten Server setzen, die privaten Links stünden im Log.
# MAIL_IN_TERMINAL=

# Wer bei jeder neuen Anmeldung eine Mail bekommt, durch Komma getrennt. Leer = niemand.
TEAM_BENACHRICHTIGUNG=
